# Local dev: SQLite file. Production: your Neon Postgres URL, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./aptitude.db

# Generate a long random value for production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Used only by seed.py when creating the first admin. Change the password for production.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=Admin@12345

# Comma-separated frontend URLs allowed to call this API (no trailing slash)
CORS_ORIGINS=http://localhost:5173
